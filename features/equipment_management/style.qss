QWidget {
    background-color: #F7F8F8;
    color: #32373B;

    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}


QLabel#formLabel {
    background-color: transparent;
    color: #4A5859;

    font-size: 13px;
    font-weight: 600;
}

QLineEdit#formInput {
    background-color: #FFFFFF;
    color: #32373B;

    border: 1px solid #C7CDCD;
    border-radius: 7px;

    min-height: 30px;

    padding: 5px 10px;
}

QLineEdit#formInput:hover {
    border: 1px solid #4A5859;
}

QLineEdit#formInput:focus {
    border: 2px solid #C83E4D;
}


QPushButton {
    background-color: #C83E4D;
    color: #FFFFFF;
    min-height: 32px;

    border: none;
    border-radius: 7px;

    padding: 6px 14px;

    font-weight: 600;
}

#addButton {
    background-color: #C83E4D;
    color: #FFFFFF;
}

#addButton:hover {
    background-color: #A92F3D;
}

#updateButton {
    background-color: #4A5859;
    color: #FFFFFF;
}

#updateButton:hover {
    background-color: #32373B;
}

#deleteButton {
    background-color: #32373B;
    color: #FFFFFF;
}

#deleteButton:hover {
    background-color: #4A5859;
}

#clearButton {
    background-color: #F4B860;
    color: #32373B;
}

#clearButton:hover {
    background-color: #E2A34A;
}


QTableWidget#dataTable {
    background-color: #FFFFFF;

    border: 1px solid #DDE1E1;
    border-radius: 8px;

    gridline-color: #E6E9E9;

    selection-background-color: #F4D6CC;
    selection-color: #32373B;

    alternate-background-color: #FAFBFB;
}

QTableWidget#dataTable::item {
    padding: 7px;
}

QTableWidget#dataTable::item:hover {
    background-color: #F4D6CC;
}

QHeaderView::section {
    background-color: #4A5859;
    color: #FFFFFF;

    border: none;
    border-right: 1px solid #5A6869;
    border-bottom: 1px solid #32373B;

    padding: 8px;

    font-size: 13px;
    font-weight: 700;
}