#addButton {
    background-color: #C83E4D;
    color: #FFFFFF;
}

#addButton:hover {
    background-color: #A92F3D;
}

#updateButton {
    background-color: #4A5859;
    color: #FFFFFF;
}

#updateButton:hover {
    background-color: #32373B;
}

#deleteButton {
    background-color: #FFFFFF;
    color: #C83E4D;
    border: 1px solid #C83E4D;
}

#deleteButton:hover {
    background-color: #D55160;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
}

#clearButton {
    background-color: #F4B860;
    color: #32373B;
}

#clearButton:hover {
    background-color: #E2A34A;
}

#searchInput {
    background-color: #FFFFFF;
    color: #32373B;
    border: 1px solid #4A5859;
    border-radius: 5px;
    padding: 4px 0px 4px 0px;
    margin: 0px 10px 0px 0px;
}

#searchInput:focus {
    border: 1px solid #C83E4D;
}