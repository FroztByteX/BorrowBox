#dashboardTitle {
    background-color: transparent;
    color: #32373B;
    font-size: 22px;
    font-weight: 700;
    padding: 4px 2px;
}

#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E7E7;
    border-radius: 9px;
}

#statTitle {
    background-color: transparent;
    color: #32373B;
    font-size: 13px;
    font-weight: 700;
}

#statValue {
    background-color: transparent;
    color: #C83E4D;
    font-size: 40px;
    font-weight: 700;
}

#chartCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E7E7;
    border-radius: 9px;
    padding: 6px;
}