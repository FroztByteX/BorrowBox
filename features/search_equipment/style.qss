QLineEdit#searchInput {
    background-color: #FFFFFF;
    color: #32373B;
    border: 1px solid #C7CDCD;
    border-radius: 7px;
    min-height: 32px;
    padding: 5px 10px;
}

QLineEdit#searchInput:hover {
    border: 1px solid #4A5859;
}

QLineEdit#searchInput:focus {
    border: 2px solid #C83E4D;
}

#primaryButton {
    background-color: #C83E4D;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    min-height: 34px;
    padding: 6px 18px;
    font-weight: 700;
}

#primaryButton:hover {
    background-color: #A92F3D;
}

#primaryButton:pressed {
    background-color: #8F2734;
}