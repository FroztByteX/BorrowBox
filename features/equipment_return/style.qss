#primaryButton {
    background-color: #C83E4D;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    min-height: 34px;
    padding: 6px 16px;
    font-weight: 700;
}

#primaryButton:hover {
    background-color: #A92F3D;
}

QPushButton {
    background-color: #C83E4D;
    color: #FFFFFF;
    min-height: 32px;
    border: none;
    border-radius: 7px;
    padding: 6px 14px;
    font-weight: 600;
}

#receiptBox {
    background-color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    border: 1px solid #DDE1E1;
    border-radius: 9px;
    margin-top: 8px;
    padding: 10px;
}

#receiptBox::title {
    color: #32373B;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    font-size: 15px;
    font-weight: 700;
}

#receiptBox QLabel {
    color: #32373B;
}